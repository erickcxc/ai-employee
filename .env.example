# Copy to .env.local. Names only: never commit a value.
# fake = everything runs locally with no keys; live = real services (fails closed if a key is missing)
PROVIDERS=fake

# Database. Empty = an in-process Postgres (PGlite) stored in .data/ for local dev.
DATABASE_URL=

# Signs per-call tokens and session cookies. 32+ random bytes.
SESSION_SECRET=
# Encrypts customer contact fields at rest. 32 random bytes, base64.
FIELD_KEY=

# Live mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_LIVE_MODEL=gpt-live-1

# Texts stay fake unless SMS_LIVE=1
SMS_LIVE=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email stays fake unless a key is set
RESEND_API_KEY=
EMAIL_FROM=
BUSINESS_ID=
APP_URL=http://localhost:3000
CRON_SECRET=
